{
  "name": "finclust-invoice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "check:pdf": "node scripts/check-pdf.mjs",
    "check:editor": "node scripts/check-editor.mjs",
    "check:history": "node scripts/check-history.mjs",
    "check:customers": "node scripts/check-customers.mjs",
    "check:companies": "node scripts/check-companies.mjs",
    "check:send": "node scripts/check-send.mjs",
    "check:payments": "node scripts/check-payments.mjs",
    "check:share": "node scripts/check-share.mjs",
    "check:dashboard": "node scripts/check-dashboard.mjs",
    "db:clear": "node --env-file=.env --import tsx scripts/clear-invoices.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.10.0",
    "lucide-react": "^0.474.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
